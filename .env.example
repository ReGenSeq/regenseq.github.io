# Formspree form IDs for community request forms.
# Create forms at https://formspree.io → copy the ID from your endpoint URL.
# For local development: copy this file to .env.local and fill in your IDs.
# For GitHub Pages deployment: add these as repository secrets in GitHub → Settings → Secrets → Actions,
# then they are passed to the Vite build automatically by .github/workflows/deploy.yml.

VITE_FORMSPREE_FLOWCELL_ID=your_flowcell_form_id_here
VITE_FORMSPREE_SEQUENCER_ID=your_sequencer_form_id_here
